# CODVAULT hors du Hub. Rien n'est obligatoire : sans SOCLE_JETON_INSTALLATION,
# un jeton est tiré au premier démarrage et écrit dans les journaux.
# SOCLE_CLE=          # clé maîtresse du socle (64 hexadécimaux) ; sinon tirée et gardée sur le volume
# SOCLE_PROXYS=       # le relais HTTPS devant CODVAULT (CIDR)
# CODVAULT_LOGOS=oui    # « non » : aucune requête sortante, les initiales seules
# CODVAULT_MAX_ELEMENTS=5000   # éléments par coffre
# CODVAULT_MAX_MIO=64          # octets chiffrés par coffre, en Mio
